# Display timezone for the kiosk board (must be NEXT_PUBLIC_ so the
# calendar Now line and header clock stay in the same zone in the browser)
NEXT_PUBLIC_HSH_TIMEZONE=Asia/Hong_Kong

# Floor this wall PC stands on (POT4F, POT5F, POT12F, POT14F, or SGB8F)
HSH_KIOSK_FLOOR=POT14F


# Optional fixed board date (YYYY-MM-DD). Default is today in NEXT_PUBLIC_HSH_TIMEZONE.
# BOARD_DATE=2026-09-01

# Microsoft Graph — leave empty to use the mock Outlook/SharePoint adapter
# Production kiosk uses client credentials (app-only) for rooms/calendars.
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=

# Temporary local coding against SharePoint as a signed-in user:
#   python3 scripts/graph-delegated.py login
#   python3 scripts/graph-delegated.py penter
# Needs delegated Sites.Read.All on the same app + "Allow public client flows".
# Token cache: .cache/graph-delegated-token.json (gitignored).

